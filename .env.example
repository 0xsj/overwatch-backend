# Every key this binary reads, with a safe value or an empty one.
# The schema, not a starting point — a key in someone's .env and not here works
# on one machine and arrives for the next person as something unrelated.
#
# Shared values are exported by the workspace Makefile from the root .env; a
# local .env overrides them. decisions/0001-three-repositories-one-root-env.

# 7002, not 7000: on macOS 7000 is AirPlay Receiver, and the bind failure
# reads as "address already in use" with nothing to point at.
PORT_SERVER=7002
DATABASE_URL=postgres://overwatch:overwatch@localhost:7020/overwatch?sslmode=disable
LOG_LEVEL=info

# Read only by the tests. They SKIP when it is unset, so a clone with no
# database still passes `go test ./...`. A SEPARATE container from DATABASE_URL:
# the suite drops and recreates schemas.
OVERWATCH_TEST_DSN=postgres://overwatch:overwatch@localhost:7021/overwatch_test?sslmode=disable

# Mail, and where a verification LINK points. BASE_URL is the CLIENT origin —
# a link is clicked in a browser and lands on a screen, not on this server.
BASE_URL=http://localhost:7010
MAIL_ADDR=localhost:7025
# Quoted: an unquoted `<` is a shell redirect and `set -a; . ./.env` dies on it.
MAIL_FROM="Overwatch <no-reply@overwatch.test>"

JOURNAL_RETENTION_DAYS=90

# Required local filesystem root for content-addressed retained artifacts.
ARTIFACT_ROOT=./var/artifacts

# Bounded run/extraction/provider limits.
RUN_TIMEOUT_SECONDS=600
RUN_MAX_OUTPUT_MB=64
OCR_BINARY=
# Optional JSON array of arguments. {input} is replaced with a private temp
# capture path; [] selects the adapter default: {input}, stdout (tesseract).
OCR_ARGS_JSON=[]
OCR_TIMEOUT_SECONDS=120
OCR_MAX_OUTPUT_MB=8
# Optional external passage-extraction, comparison, question-suggestion,
# brief-draft, and connection-review provider. It receives a private JSON input
# file at {input}; empty selects deterministic local paths. Responses must be
# strict JSON objects with lifecycle status and exact observation_ids; brief
# drafts return a reviewable authored-section diff and connection review returns
# cited findings.
ASSISTANCE_BINARY=
# Optional JSON array of arguments shared by external assistance adapters;
# {input} is replaced with a private JSON input path.
ASSISTANCE_ARGS_JSON=[]
ASSISTANCE_TIMEOUT_SECONDS=120
ASSISTANCE_MAX_OUTPUT_MB=8

# Optional selected-observation synthesis provider. Empty uses the local,
# deterministic review pass. The process receives only the selected evidence
# and must return one grounded JSON synthesis object.
SYNTHESIS_BINARY=
# Optional JSON array of arguments for the synthesis adapter; {input} is
# replaced with a private JSON input path.
SYNTHESIS_ARGS_JSON=[]
SYNTHESIS_TIMEOUT_SECONDS=120
SYNTHESIS_MAX_OUTPUT_MB=8

# The scheduler is disabled with a zero batch size.
SCHEDULER_EVERY_SECONDS=60
SCHEDULER_BATCH=8
SESSION_TTL_SECONDS=1209600
