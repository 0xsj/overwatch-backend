# Every key this binary reads, with a safe value or an empty one.
# The schema, not a starting point — a key in someone's .env and not here works
# on one machine and arrives for the next person as something unrelated.
#
# Shared values are exported by the workspace Makefile from the root .env; a
# local .env overrides them. decisions/0001-three-repositories-one-root-env.

# 7002, not 7000: on macOS 7000 is AirPlay Receiver, and the bind failure
# reads as "address already in use" with nothing to point at.
PORT_SERVER=7002
DATABASE_URL=postgres://overwatch:overwatch@localhost:7020/overwatch?sslmode=disable
LOG_LEVEL=info

# Read only by the tests. They SKIP when it is unset, so a clone with no
# database still passes `go test ./...`. A SEPARATE container from DATABASE_URL:
# the suite drops and recreates schemas.
OVERWATCH_TEST_DSN=postgres://overwatch:overwatch@localhost:7021/overwatch_test?sslmode=disable
